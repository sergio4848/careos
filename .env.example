# =============================================================================
# CareOS environment configuration
# -----------------------------------------------------------------------------
# Copy to `.env` for local overrides:  cp .env.example .env
# docker-compose.yml ships DEVELOPMENT-ONLY defaults for every value below so
# `docker compose up` works without a .env file. Those defaults are insecure by
# design and the API refuses to start with them when CAREOS_ENVIRONMENT=production.
# NEVER commit a real .env file. Never put real provider credentials here.
# =============================================================================

# --- Runtime -------------------------------------------------------------------
# development | test | staging | production
CAREOS_ENVIRONMENT=development
CAREOS_LOG_LEVEL=INFO
# JSON logs for containers/log shippers; set false for human-readable local logs
CAREOS_LOG_JSON=true

# --- PostgreSQL ----------------------------------------------------------------
POSTGRES_USER=careos
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=careos
CAREOS_DATABASE_URL=postgresql+asyncpg://careos:change-me-local-db-password@postgres:5432/careos
CAREOS_DATABASE_POOL_SIZE=10

# --- Redis (realtime fan-out + rate limiting; NOT the source of truth) ---------
CAREOS_REDIS_URL=redis://redis:6379/0
# Redis is optional: short timeouts + circuit breaker keep an outage off the alarm path.
CAREOS_REDIS_TIMEOUT_SECONDS=0.5
CAREOS_REDIS_CIRCUIT_RESET_SECONDS=5
CAREOS_REALTIME_PUBLISH_TIMEOUT_SECONDS=1

# --- Security ------------------------------------------------------------------
# >= 32 random chars. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
CAREOS_SECRET_KEY=replace-with-at-least-32-random-characters
CAREOS_SESSION_TTL_MINUTES=720
CAREOS_SESSION_IDLE_TIMEOUT_MINUTES=120
# true behind HTTPS (staging/production)
CAREOS_COOKIE_SECURE=false
# e.g. .careos.example when web and api live on sibling sub-domains; empty = host-only
CAREOS_COOKIE_DOMAIN=
# Comma separated list of browser origins allowed to call the API / open WebSockets
CAREOS_CORS_ALLOWED_ORIGINS=http://localhost:3000
CAREOS_LOGIN_MAX_ATTEMPTS=10
CAREOS_LOGIN_WINDOW_SECONDS=300
CAREOS_GATEWAY_MAX_REQUESTS_PER_MINUTE=600

# --- Device gateway & SOS simulator (development only) -------------------------
CAREOS_SIMULATOR_ENABLED=true
# Gateway credential the simulator uses to reach the Event Gateway like a real device platform.
# Format: cgk_<8 char prefix>_<secret>. The seed command registers it for "Demo Care UK".
CAREOS_SIMULATOR_GATEWAY_KEY=cgk_demo0001_replace-with-a-random-secret-value
# Where the simulator sends device payloads (the API itself inside the container)
CAREOS_GATEWAY_INTERNAL_URL=http://localhost:8000

# --- Providers (all critical workflows go through provider abstractions) -------
# voice: mock | disabled
CAREOS_VOICE_PROVIDER=mock
# notification: mock | disabled
CAREOS_NOTIFICATION_PROVIDER=mock
# ai: mock | mock_unavailable | disabled   (AI is never safety-critical)
CAREOS_AI_PROVIDER=mock
# mock voice behaviour: no_answer | answered_acknowledged | failure
CAREOS_MOCK_VOICE_OUTCOME=no_answer
CAREOS_PROVIDER_TIMEOUT_SECONDS=10

# --- Real telephony (Twilio) — ALL OPTIONAL, mock voice needs none of this -------
# Master safety switch: unless true, TwilioVoiceProvider refuses every call.
CAREOS_REAL_TELEPHONY_ENABLED=false
# Outside production, real calls may only reach these E.164 numbers (comma separated).
# Never commit personal numbers; keep them in your local .env only.
CAREOS_TELEPHONY_ALLOWED_NUMBERS=
# Placeholders only — real credentials live in your local .env / secret store.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-twilio-auth-token
TWILIO_FROM_NUMBER=+44xxxxxxxxxx
# UK-first: Ireland region keeps call control in the EU. Empty = Twilio global (US).
TWILIO_REGION=ie1
TWILIO_EDGE=dublin
# Public HTTPS base Twilio can reach (status callbacks + wss:// media stream).
CAREOS_TWILIO_WEBHOOK_BASE_URL=
CAREOS_TWILIO_API_TIMEOUT_SECONDS=10
CAREOS_TWILIO_RING_TIMEOUT_SECONDS=30
CAREOS_VOICE_CALL_MAX_DURATION_SECONDS=240

# --- AI voice (OpenAI Realtime) — OPTIONAL, mock | openai_realtime | disabled ----
CAREOS_AI_VOICE_PROVIDER=mock
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_REALTIME_MODEL=gpt-realtime
CAREOS_AI_CONNECT_TIMEOUT_SECONDS=10
CAREOS_AI_RESPONSE_TIMEOUT_SECONDS=30

# --- Worker / escalation -------------------------------------------------------
CAREOS_WORKER_POLL_INTERVAL_SECONDS=1.0
CAREOS_WORKER_BATCH_SIZE=20
CAREOS_WORKER_LEASE_SECONDS=60
# Steps overdue by more than this mark the worker as lagging (/ready, dashboard banner).
CAREOS_ESCALATION_OVERDUE_AFTER_SECONDS=60
CAREOS_ESCALATION_MAX_ATTEMPTS=3
CAREOS_DEVICE_OFFLINE_AFTER_SECONDS=86400
CAREOS_DEVICE_LOW_BATTERY_THRESHOLD=20
# Development only: run the worker loops inside the API process (single process, no Redis needed)
CAREOS_EMBEDDED_WORKER=false

# --- Demo seed -----------------------------------------------------------------
# Password assigned to seeded demo users (development only)
CAREOS_SEED_DEMO_PASSWORD=replace-with-a-demo-password

# --- Web (Next.js) -------------------------------------------------------------
# Read at runtime by the Next.js server and handed to the browser.
CAREOS_PUBLIC_API_URL=http://localhost:8000
CAREOS_PUBLIC_WS_URL=ws://localhost:8000/v1/ws
